<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 24dp 图形置于 48dp 触摸区，统一返回、清空和首页动作的反馈。 -->
    <style name="Weather.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Weather.Toolbar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">@dimen/page_gutter</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Weather.ToolbarTitle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/toolbar_title_size</item>
    </style>

    <!-- 普通页面使用 M3 表面色；天气页继续使用透明工具栏和白字。 -->
    <style name="Weather.Toolbar.Surface" parent="Weather.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="Weather.ToolbarTitle.Surface" parent="Weather.ToolbarTitle">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 场景上方的操作使用 M3 描边按钮，并保持足够的文字与图标对比度。 -->
    <style name="Weather.Button.OnForecast" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="strokeColor">@color/text_secondary_on_dark</item>
        <item name="rippleColor">@color/city_tag_ripple</item>
    </style>

    <style name="Weather.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_on_dark</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 关于页入口整行可点击，长标题可换行，窄屏和大字体下仍能阅读。 -->
    <style name="Weather.DocumentRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">@dimen/body_text_size</item>
        <item name="android:textColor">@color/about_text_primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:drawableTint">@color/about_text_secondary</item>
        <item name="android:drawablePadding">16dp</item>
    </style>
</resources>
