<?xml version="1.0" encoding="utf-8"?>
<!-- 版本、作者、离线文档入口与数据署名集中在关于页。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/about_page_bg"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/toolbar"
        style="@style/Weather.Toolbar.Surface">
        <ImageView android:id="@+id/button_back"
            style="@style/Weather.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" app:tint="?attr/colorOnSurface" />
        <TextView android:id="@+id/text_title"
            style="@style/Weather.ToolbarTitle.Surface" android:text="@string/about_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/scroll_content"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false"
        android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="@dimen/page_gutter"
            android:paddingTop="24dp" android:paddingBottom="24dp">
            <ImageView android:id="@+id/image_logo"
                android:layout_width="96dp" android:layout_height="96dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
                android:contentDescription="@null" android:src="@drawable/ic_weather_logo" />
            <TextView android:id="@+id/text_version"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
                android:textColor="@color/about_text_primary" android:textSize="20sp"
                android:fontFamily="sans-serif-medium" tools:text="氢天气 V1.2" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center"
                android:text="@string/about_tagline" android:textColor="@color/about_text_secondary"
                android:textSize="@dimen/body_text_size" />

            <!-- 沿用拼图工坊公开的作者资料，抖音入口展示二维码并支持复制账号。 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="vertical"
                android:background="@drawable/bg_about_section">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="8dp"
                    android:text="@string/about_author" android:textColor="@color/about_text_primary"
                    android:fontFamily="sans-serif-medium" android:textSize="16sp" />
                <TextView android:id="@+id/row_github"
                    style="@style/Weather.DocumentRow" android:text="@string/about_github" />
                <TextView android:id="@+id/row_douyin"
                    style="@style/Weather.DocumentRow" android:text="@string/about_douyin" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="vertical"
                android:background="@drawable/bg_about_section">
                <TextView android:id="@+id/row_changelog"
                    style="@style/Weather.DocumentRow" android:text="@string/about_changelog_title" />
                <TextView android:id="@+id/row_user_guide"
                    style="@style/Weather.DocumentRow" android:text="@string/about_user_guide" />
                <TextView android:id="@+id/row_user_agreement"
                    style="@style/Weather.DocumentRow" android:text="@string/about_user_agreement" />
                <TextView android:id="@+id/row_privacy_policy"
                    style="@style/Weather.DocumentRow" android:text="@string/about_privacy_policy" />
                <TextView android:id="@+id/row_third_party"
                    style="@style/Weather.DocumentRow" android:text="@string/about_third_party" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/about_data_source"
                android:lineSpacingMultiplier="1.3" android:textColor="@color/about_text_secondary"
                android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/about_independence"
                android:lineSpacingMultiplier="1.3" android:textColor="@color/about_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
