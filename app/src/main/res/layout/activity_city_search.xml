<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索添加页(DESIGN.md §6.4):深色底 + 搜索框(自动聚焦)+ 热门城市 tag 区 + 结果列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fifteen_day_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        style="@style/Weather.Toolbar">

        <ImageView
            android:id="@+id/button_back"
            style="@style/Weather.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/text_title"
            style="@style/Weather.ToolbarTitle"
            android:text="@string/add_city" />
    </LinearLayout>

    <!-- 搜索框:深色圆角底 + 白字 + 次要色 hint;自动聚焦由 Activity 发起 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/page_gutter"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary_on_dark" />

        <EditText
            android:id="@+id/edit_query"
            android:minHeight="@dimen/touch_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary_on_dark"
            android:textCursorDrawable="@null"
            android:textSize="15sp"
            tools:text="大连市" />

        <ImageView
            android:id="@+id/button_clear"
            style="@style/Weather.IconButton"
            android:contentDescription="@string/clear_input"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary_on_dark"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 热门城市独立滚动，短窗口或字体放大时仍可触及最后一项。 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/popular_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/space_small"
            android:paddingBottom="@dimen/page_gutter">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_gutter"
                android:paddingEnd="@dimen/page_gutter"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="2dp" />
        </androidx.core.widget.NestedScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_results"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="24dp"
            tools:itemCount="6"
            tools:listitem="@layout/item_search_result" />

        <ProgressBar
            android:id="@+id/progress_searching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_secondary_on_dark"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="搜索失败,请检查网络" />

        <TextView
            android:id="@+id/text_no_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/search_no_result"
            android:textColor="@color/text_secondary_on_dark"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
