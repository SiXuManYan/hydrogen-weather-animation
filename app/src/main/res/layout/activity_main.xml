<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/weather_sun">

    <com.sugar.weather.view.WeatherBackdropView
        android:id="@+id/weather_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ui_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/text_debug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_overlay_pill"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="pitch 90.0°   roll 0.0°   模拟"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_scene"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_overlay_pill"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="晴天 · 日间" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_scene"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/weather_overlay_scrim"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="64dp"
                android:minHeight="36dp"
                android:text="@string/scene_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:elevation="0dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
