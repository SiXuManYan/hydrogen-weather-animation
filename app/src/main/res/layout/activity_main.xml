<?xml version="1.0" encoding="utf-8"?>
<!-- 主页面(DESIGN.md §6.2,D10 方案):
     单实例 WeatherBackdropView 永远只渲染当前选中城市,其上透明 ViewPager2 承载每城市一页,
     最上层头部 overlay(图钉 + 城市名/更新时间 + 告警占位 + 城市管理 + 溢出菜单)。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/weather_sun">

    <com.sugar.weather.view.WeatherBackdropView
        android:id="@+id/weather_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <FrameLayout
        android:id="@+id/ui_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 标题以剩余宽度排版，长城市名不会挤占右侧动作。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_header_height"
            android:layout_gravity="top"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_pin"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/space_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/text_primary_on_dark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_city_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        tools:text="沙河口区" />

                    <TextView
                        android:id="@+id/text_updated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary_on_dark"
                        android:textSize="12sp"
                        tools:text="刚刚更新" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/header_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_alert"
                    style="@style/Weather.IconButton"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alert"
                    android:visibility="gone"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/image_city_manage"
                    style="@style/Weather.IconButton"
                    android:contentDescription="@string/choose_city"
                    android:src="@drawable/ic_city_manage"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/image_more"
                    style="@style/Weather.IconButton"
                    android:contentDescription="@string/more_options"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- 传感器调试文本(溢出菜单「动画调试」开关控制) -->
        <TextView
            android:id="@+id/text_debug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_overlay_pill"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="pitch 90.0°   roll 0.0°   模拟"
            tools:visibility="visible" />

        <!-- 首启空状态(D8:不预置假城市):图钉 + 引导文案 + 添加城市 -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/page_gutter"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/text_secondary_on_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_state_hint"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add_city"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/add_city"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/text_secondary_on_dark" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
