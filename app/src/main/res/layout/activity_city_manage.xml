<?xml version="1.0" encoding="utf-8"?>
<!-- 城市管理使用 M3 普通表面与 FAB，天气卡继续独立显示动画。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/city_manage_page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        style="@style/Weather.Toolbar.Surface">

        <ImageView
            android:id="@+id/button_back"
            style="@style/Weather.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_title"
            style="@style/Weather.ToolbarTitle.Surface"
            android:text="@string/choose_city" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:indeterminate="true"
            app:indicatorSize="20dp"
            app:indicatorInset="0dp"
            app:trackThickness="2dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/button_edit"
            style="@style/Weather.IconButton"
            android:contentDescription="@string/city_edit"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/button_delete"
            style="@style/Weather.IconButton"
            android:contentDescription="@string/city_delete"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/page_gutter"
        android:text="@string/city_manage_hint"
        android:textColor="@color/about_text_secondary"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_cities"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="96dp"
            tools:itemCount="5"
            tools:listitem="@layout/item_city_card" />

        <TextView
            android:id="@+id/text_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/city_manage_empty"
            android:textColor="@color/about_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/button_add"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="@dimen/page_gutter"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/add_city"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/ic_add" />
    </FrameLayout>
</LinearLayout>
