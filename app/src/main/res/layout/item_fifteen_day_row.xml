<?xml version="1.0" encoding="utf-8"?>
<!-- 描述与降水概率分为两行，将有限宽度留给天气文字。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/page_gutter"
    android:paddingTop="@dimen/space_medium"
    android:paddingEnd="@dimen/page_gutter"
    android:paddingBottom="@dimen/space_medium">

    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            tools:text="明天" />

        <TextView
            android:id="@+id/text_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary_on_dark"
            android:textSize="12sp"
            tools:text="11月6日" />
    </LinearLayout>

    <ImageView
        android:id="@+id/image_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_sun" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_on_dark"
            android:textSize="14sp"
            tools:text="小雨转晴" />

        <TextView
            android:id="@+id/text_precip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary_on_dark"
            android:textSize="11sp"
            tools:text="降水概率 35%" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:gravity="end"
        android:textColor="@color/white"
        android:textSize="18sp"
        tools:text="16°" />

    <TextView
        android:id="@+id/text_low"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:layout_marginStart="4dp"
        android:gravity="end"
        android:textColor="@color/text_secondary_on_dark"
        android:textSize="18sp"
        tools:text="3°" />
</LinearLayout>
