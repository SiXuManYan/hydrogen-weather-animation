<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 数据层(DESIGN.md §10.3):Open-Meteo 网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 框架 LocationManager 定位(决策 D7,不依赖 GMS);权限申请由 UI 层发起 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 11+ 查询支持 Custom Tabs 的浏览器，不申请额外权限。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".WeatherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weather">

        <!-- 系统以显式广播通知生命周期，刷新 PendingIntent 由本应用签发。 -->
        <receiver
            android:name=".widget.WeatherWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Weather"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 15 天天气预报详情页(DESIGN.md §3/D9,主页「15 天天气预报」按钮入口) -->
        <activity
            android:name=".ui.fifteenday.FifteenDayActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Weather.Detail" />

        <!-- 城市管理页(§6.5):setResult(cityId) 回传主页切页 -->
        <activity
            android:name=".ui.city.CityManageActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Weather.Detail" />

        <!-- 搜索添加页(§6.4):防抖搜索 + 热门城市,添加成功回传城市 id -->
        <activity
            android:name=".ui.search.CitySearchActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Weather.Detail"
            android:windowSoftInputMode="adjustResize" />

        <!-- 关于页(§7):静态页 -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Weather.Detail" />

        <!-- 包内 Markdown 阅读页，无网络或定位前置条件。 -->
        <activity
            android:name=".ui.about.DocumentActivity"
            android:exported="false"
            android:theme="@style/Theme.Weather.Detail" />
    </application>

</manifest>
